{
  "name": "venu2-moat-portfolio",
  "version": "2.1.0",
  "description": "MoatWatch — Multi-Device Garmin Portfolio Companion (20 Models 2024-2026) with Daily US Market Fear & Greed Index, Auto-Swipe, Always-On Display, 14-Day Trial & Per-Device Licensing Admin Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/sdlc.test.js",
    "test:webmemo": "node tests/webmemo-integration.test.js",
    "build:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-and-sideload.ps1",
    "cf:login": "npx wrangler login",
    "cf:bundle": "npx wrangler deploy --dry-run --outdir dist/worker-bundle",
    "cf:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy-cloudflare.ps1",
    "git:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./sync-github.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
